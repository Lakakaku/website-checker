# Database (Railway PostgreSQL)
DATABASE_URL="postgresql://username:password@region.railway.app:5432/database_name"

# Redis (Railway Redis for BullMQ job queue)
REDIS_URL="redis://default:password@region.railway.app:6379"

# Stripe API (Use sk_test_* for development/staging, sk_live_* for production)
STRIPE_API_KEY="sk_test_your_stripe_test_key_here"

# Sentry Error Monitoring
SENTRY_DSN="https://your_sentry_key@o123456.ingest.sentry.io/7654321"

# NextAuth.js (Generate secret with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-32-character-secret-here-replace-me"
NEXTAUTH_URL="http://localhost:3000"

# Node Environment (development | production | test)
NODE_ENV="development"