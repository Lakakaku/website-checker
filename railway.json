{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @website-checker/database prisma:generate && pnpm --filter @website-checker/worker build",
    "watchPatterns": [
      "apps/worker/**",
      "packages/**",
      "pnpm-lock.yaml"
    ]
  },
  "deploy": {
    "runtime": "NODE",
    "startCommand": "pnpm --filter @website-checker/worker start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30
  },
  "environments": {
    "production": {
      "branch": "main",
      "rootDirectory": "/",
      "variables": {
        "NODE_ENV": "production",
        "PORT": "3001"
      }
    }
  }
}