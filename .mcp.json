    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://postgres:hXcJgQnZXkBQZLTexzVcmAiQibILSpOa@trolley.proxy.rlwy.net:47608/railway"
      ]
    },
    "stripe": {
