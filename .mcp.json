{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"]
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "@henkey/postgres-mcp-server", "--connection-string", "${DATABASE_URL}"]
    },
    "redis": {
      "command": "npx",
      "args": [
        "-y",
        "redis-mcp",
        "--redis-host",
        "interchange.proxy.rlwy.net",
        "--redis-port",
        "33477"
      ]
    },
    "railway": {
      "command": "npx",
      "args": ["-y", "@jasontanswe/railway-mcp"],
      "env": {
        "RAILWAY_API_TOKEN": "${RAILWAY_API_TOKEN}"
      }
    },
    "vercel": {
      "command": "npx",
      "args": ["-y", "@mistertk/vercel-mcp"],
      "env": {
        "VERCEL_API_KEY": "iR2em9atNHlk89Qv0IXSvBdE"
      },
      "description": "Vercel MCP for deployment and hosting operations"
    }
  }
}
