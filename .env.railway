# Railway Environment Variables Template
# Copy these to your Railway service settings

# Core Configuration
NODE_ENV=production
PORT=3001

# Database - Use Railway's PostgreSQL reference
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Redis - Use Railway's Redis reference
REDIS_URL=${{Redis.REDIS_PUBLIC_URL}}

# Authentication (same as Vercel)
NEXTAUTH_SECRET=your-secret-here-min-32-chars
NEXTAUTH_URL=https://your-domain.vercel.app

# Stripe (same as Vercel)
STRIPE_API_KEY=sk_live_your_key_here

# Monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id